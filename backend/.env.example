# Copy to .env and fill in. Never commit .env.

# ── LLM gateway (OpenAI-compatible; any model id the gateway serves) ──
AICREDITS_API_KEY=replace-me
AICREDITS_BASE_URL=https://api.aicredits.in/v1
LLM_MODEL=gpt-4o-mini
# json_schema (strict, preferred) | function_calling | json_mode
LLM_STRUCTURED_METHOD=json_schema
LLM_TEMPERATURE=0.3

# ── LangSmith monitoring (read directly by LangChain/LangGraph) ───────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-arena

# ── Market data ───────────────────────────────────────────────────────
# Upstox access tokens expire daily at 03:30 IST.
UPSTOX_ANALYTICS_TOKEN=
TWELVE_DATA_API_KEY=

# ── Database ──────────────────────────────────────────────────────────
# Postgres via `docker compose up postgres`:
DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena
# Zero-setup alternative:
# DATABASE_URL=sqlite:///./arena.db

# ── Universe / history ────────────────────────────────────────────────
UNIVERSE_INDEX=NIFTY 500
HISTORY_DAYS=800

# ── Portfolio ─────────────────────────────────────────────────────────
DEFAULT_CAPITAL=100000
TOP_CANDIDATES=15

# ── Scheduler (24h IST) ───────────────────────────────────────────────
MORNING_HOUR=8
MORNING_MINUTE=40
CLOSING_HOUR=15
CLOSING_MINUTE=45
NIGHTLY_HOUR=20
NIGHTLY_MINUTE=15
