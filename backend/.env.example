# Copy to .env and fill in. Never commit .env.

# ── LLM gateway (OpenAI-compatible) ───────────────────────────────────
AICREDITS_API_KEY=replace-me
AICREDITS_BASE_URL=https://api.aicredits.in/v1

# ── Market data ───────────────────────────────────────────────────────
# Upstox access tokens expire daily at 03:30 IST.
UPSTOX_ANALYTICS_TOKEN=
TWELVE_DATA_API_KEY=

# ── Database ──────────────────────────────────────────────────────────
# SQLite for a quick start; Postgres for real work:
# DATABASE_URL=postgresql+psycopg2://arena:arena@localhost:5432/arena
DATABASE_URL=sqlite:///./arena.db

# ── Portfolio ─────────────────────────────────────────────────────────
DEFAULT_CAPITAL=100000
TOP_CANDIDATES=15

# ── Scheduler (24h IST) ───────────────────────────────────────────────
MORNING_HOUR=8
MORNING_MINUTE=40
CLOSING_HOUR=15
CLOSING_MINUTE=45
