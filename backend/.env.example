# Copy to .env and fill in. Never commit .env.

# ── LLM gateway (OpenAI-compatible; any model id the gateway serves) ──
AICREDITS_API_KEY=replace-me
AICREDITS_BASE_URL=https://api.aicredits.in/v1
LLM_MODEL=gpt-4o-mini
# json_schema (strict, preferred) | function_calling | json_mode
LLM_STRUCTURED_METHOD=json_schema
LLM_TEMPERATURE=0.3

# ── Chat assistant ────────────────────────────────────────────────────
CHAT_MODEL=gpt-4o-mini
CHAT_GUARD_MODEL=openai/gpt-4.1-nano
CHAT_RATE_LIMIT_PER_MIN=12
CHAT_WEB_SEARCH=true

# ── Fallback provider (optional) ──────────────────────────────────────
# Used automatically while the primary gateway is unreachable, then switched back.
# Groq free tier example:  https://api.groq.com/openai/v1  +  llama-3.3-70b-versatile
# OpenAI example:          https://api.openai.com/v1       +  gpt-4o-mini
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_STRUCTURED_METHOD=function_calling
LLM_FAILOVER_SECONDS=300

# ── LangSmith monitoring (read directly by LangChain/LangGraph) ───────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-arena

# ── Alerts and credit tracking ────────────────────────────────────────
# Optional push channels for alerts (job failures, credits exhausted, expired tokens, stale data).
# Telegram: create a bot with @BotFather, message it once, put its token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any URL that accepts a JSON POST (Slack/Discord webhook, n8n, Zapier…):
ALERT_WEBHOOK_URL=
# Tell the app your gateway balance once; it meters every call and projects the run-out date.
LLM_CREDITS_USD=0
LLM_CREDITS_AS_OF=
# Warn when less than this % or this many days of credits remain.
ALERT_CREDITS_LOW_PCT=20
ALERT_CREDITS_LOW_DAYS=14
# Hard daily cap on estimated AI spend. When reached, Voxa, explanations and the AI managers pause
# until midnight; heartbeat and everything non-AI keep running. 0 disables the cap.
LLM_DAILY_BUDGET_INR=5
USD_INR=88

# ── Market data ───────────────────────────────────────────────────────
# Upstox access tokens expire daily at 03:30 IST.
UPSTOX_ANALYTICS_TOKEN=
TWELVE_DATA_API_KEY=

# ── Database ──────────────────────────────────────────────────────────
# Postgres via `docker compose up postgres`:
DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena
# Zero-setup alternative:
# DATABASE_URL=sqlite:///./arena.db

# ── Universe / history ────────────────────────────────────────────────
UNIVERSE_INDEX=NIFTY 500
HISTORY_DAYS=800

# ── Portfolio ─────────────────────────────────────────────────────────
DEFAULT_CAPITAL=100000
TOP_CANDIDATES=15

# ── Scheduler (24h IST) ───────────────────────────────────────────────
MORNING_HOUR=8
MORNING_MINUTE=40
CLOSING_HOUR=15
CLOSING_MINUTE=45
NIGHTLY_HOUR=20
NIGHTLY_MINUTE=15
