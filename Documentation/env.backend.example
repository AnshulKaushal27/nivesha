# Backend Environment Template
# Copy this to backend/.env and fill in your actual values

# ═══════════════════════════════════════════════════════════════════
# AI Credits API (Required for AI model portfolio recommendations)
# ═══════════════════════════════════════════════════════════════════
# Get your API key from: https://aicredits.in
AICREDITS_API_KEY=your_api_key_here_get_from_aicredits_in
AICREDITS_BASE_URL=https://api.aicredits.in/v1

# ═══════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════
# For local development (SQLite):
DATABASE_URL=sqlite:///./arena.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/arena_db

# ═══════════════════════════════════════════════════════════════════
# Portfolio Configuration
# ═══════════════════════════════════════════════════════════════════
DEFAULT_CAPITAL=100000.0
TOP_CANDIDATES=15

# ═══════════════════════════════════════════════════════════════════
# Scheduler Timing (IST — Indian Standard Time)
# ═══════════════════════════════════════════════════════════════════
# Morning simulation (9:40 AM IST):
MORNING_HOUR=8
MORNING_MINUTE=40

# Closing simulation (3:45 PM IST):
CLOSING_HOUR=15
CLOSING_MINUTE=45

# ═══════════════════════════════════════════════════════════════════
# Market Data APIs (Optional)
# ═══════════════════════════════════════════════════════════════════
# Upstox Analytics Token
UPSTOX_ANALYTICS_TOKEN=

# Twelve Data API Key (for historical stock data)
TWELVE_DATA_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Logging Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
